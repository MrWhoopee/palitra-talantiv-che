NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://palitra:palitra@localhost:5433/palitra?schema=public&options=-c%20TimeZone%3DUTC
WEB_ORIGIN=http://localhost:3000

# Signs access tokens. Generate your own, never reuse this placeholder:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Палітра талантів <no-reply@palitra-talantiv.local>

# Куди лягають завантажені зображення і за якою адресою вони роздаються.
# Відносний шлях рахується від робочої теки API. На хостингу з ефемерною
# файловою системою сюди монтується волюм — інакше картинки зникнуть при
# перезапуску.
STORAGE_DIR=var/uploads
PUBLIC_API_URL=http://localhost:4000
