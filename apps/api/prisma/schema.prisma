generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

/// The role is a field rather than a table: there are exactly three fixed
/// roles, so a full RBAC schema would be overengineering (see the design doc).
model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  /// Always stored lower-cased and trimmed - normalisation happens in the
  /// shared zod schema, which every write path goes through. Without it a
  /// `Olena@` and an `olena@` would both satisfy this unique index.
  email           String    @unique
  /// Null until the person sets one. An invited teacher has an account before
  /// they have a password, and until then there is no way to sign in as them:
  /// every login path checks for null *before* reaching the hash comparison,
  /// rather than trusting bcrypt to reject an empty digest.
  passwordHash    String?
  role            UserRole  @default(STUDENT)
  firstName       String
  lastName        String
  phone           String
  avatarUrl       String?
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  refreshTokens    RefreshToken[]
  oneTimeTokens    OneTimeToken[]
  teacherProfile   TeacherProfile?
  lessons          Lesson[]           @relation("StudentLessons")
  cancelledLessons Lesson[]           @relation("CancelledLessons")
  subscriptions    Subscription[]     @relation("StudentSubscriptions")
  enrollments      GroupEnrollment[]
  attendance       LessonAttendance[]

  @@index([role])
}

/// One row per active session. The token itself is never stored - only its
/// SHA-256 digest, so a leaked database dump cannot be replayed as a login.
/// SHA-256 rather than bcrypt is deliberate: the token is 32 random bytes, so
/// there is no dictionary to slow an attacker down, and refresh runs on every
/// expired access token - a deliberately slow hash would be a self-inflicted
/// denial of service.
model RefreshToken {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique
  expiresAt         DateTime  @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  /// Set when rotation issues the successor of this token. A request that
  /// presents an already-rotated token is either a replay of a stolen one or a
  /// race, and the whole chain gets revoked.
  replacedByTokenId String?   @db.Uuid
  userAgent         String?
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum OneTimeTokenKind {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  INVITE
}

/// Email verification, password reset and teacher invitations share one table
/// because they are the same object: a single-use, expiring, hashed secret
/// bound to a user. The `kind` keeps them from being used interchangeably - a
/// verification link must not be redeemable as a password reset, and an
/// invitation must not be redeemable as either.
model OneTimeToken {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @db.Uuid
  kind      OneTimeTokenKind
  tokenHash String           @unique
  expiresAt DateTime         @db.Timestamptz(3)
  usedAt    DateTime?        @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([expiresAt])
}

/// Where lessons happen. Two addresses today, so this is a small reference
/// table rather than a free-text field on the teacher: the public site puts
/// them on a map, and availability rules point at one.
model Location {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  address   String
  mapUrl    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  teachers TeacherLocation[]
  rules    AvailabilityRule[]
  lessons  Lesson[]
  groups   Group[]
  events   StudioEvent[]
}

/// What the studio teaches: vocals, piano, guitar, ukulele.
///
/// A reference table rather than an enum on the teacher, because "show
/// everyone who teaches guitar" and "list the directions with their prices"
/// would otherwise read from two different places that can disagree.
model Direction {
  id          String   @id @default(uuid(7)) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  teachers   TeacherDirection[]
  pricePlans PricePlan[]
  groups     Group[]
}

/// The teaching side of a user account. Keyed by `userId` rather than by an id
/// of its own, so a teacher has exactly one identity across the system: every
/// `teacherId` in the schema is a user id, and the ownership checks in the
/// services compare it directly against the token's `userId`.
model TeacherProfile {
  userId          String   @id @db.Uuid
  bio             String?
  experienceYears Int?
  photoUrl        String?
  /// The same teacher, cut out against nothing: a full-length figure with a
  /// transparent ground, which is what the show's teacher scene stands on
  /// stage. It is a second photograph rather than a crop of the first - a
  /// square portrait taken from the chest up cannot become a whole person -
  /// so it is a field of its own and either may be missing.
  cutoutUrl       String?
  /// Unpublished profiles exist for teachers who have not sent a photo yet -
  /// they can already be scheduled, they are simply not on the public site.
  isPublished     Boolean  @default(false)
  /// A teacher who has left. Deleting them is not an option: their finished
  /// lessons refer to them, and history is not rewritten to tidy a list. This
  /// is the scheduling half of the pair - `isPublished` hides them from the
  /// site, `isActive` keeps them out of new bookings and free-slot search.
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations     TeacherLocation[]
  directions    TeacherDirection[]
  rules         AvailabilityRule[]
  exceptions    AvailabilityException[]
  lessons       Lesson[]
  groups        Group[]
  subscriptions Subscription[]
}

model TeacherLocation {
  teacherId  String @db.Uuid
  locationId String @db.Uuid

  teacher  TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  location Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([teacherId, locationId])
  @@index([locationId])
}

model TeacherDirection {
  teacherId   String @db.Uuid
  directionId String @db.Uuid

  teacher   TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  direction Direction      @relation(fields: [directionId], references: [id], onDelete: Cascade)

  @@id([teacherId, directionId])
  @@index([directionId])
}

/// A recurring working window: "Tuesdays, 10:00-18:00 on Blahovisna".
///
/// The time of day is stored as minutes since local midnight and the weekday
/// as a number, not as an instant. That is the whole point: the same rule has
/// to mean 17:00 in Kyiv in January and 17:00 in Kyiv in July, which are
/// different moments in UTC. Expanding a rule into real dates happens in
/// `computeFreeSlots`, in the studio's zone.
model AvailabilityRule {
  id          String    @id @default(uuid(7)) @db.Uuid
  teacherId   String    @db.Uuid
  locationId  String    @db.Uuid
  /// 0 = Sunday, matching `Date.prototype.getUTCDay`.
  weekday     Int       @db.SmallInt
  /// Minutes since local midnight, 0-1439 for the start and 1-1440 for the end.
  startMinute Int       @db.SmallInt
  endMinute   Int       @db.SmallInt
  /// A calendar date, not an instant: changing the timetable from the first of
  /// September must not depend on where the reader is standing. `validTo` lets
  /// a schedule change without deleting the history behind it.
  validFrom   DateTime  @db.Date
  validTo     DateTime? @db.Date
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  teacher  TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)
  location Location       @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([teacherId, weekday])
}

enum AvailabilityExceptionKind {
  VACATION
  SICK
  BLOCKED
}

/// Time cut out of the working rules: a holiday, an illness, an afternoon
/// blocked for a concert. Stored as a range of instants rather than a mark on
/// a day, because a holiday can start halfway through one.
model AvailabilityException {
  id        String                    @id @default(uuid(7)) @db.Uuid
  teacherId String                    @db.Uuid
  startsAt  DateTime                  @db.Timestamptz(3)
  endsAt    DateTime                  @db.Timestamptz(3)
  kind      AvailabilityExceptionKind
  note      String?
  createdAt DateTime                  @default(now()) @db.Timestamptz(3)

  teacher TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Cascade)

  @@index([teacherId, startsAt])
}

enum LessonFormat {
  INDIVIDUAL
  GROUP
}

/// A tariff: "Вокал, 8 занять по 45 хвилин, індивідуально".
///
/// The plan is what fixes a lesson's duration - the student picks a tariff,
/// not a length. Prices are whole hryvnias; there are no fractional prices in
/// the studio's list and integers cannot drift the way money in a float does.
model PricePlan {
  id              String       @id @default(uuid(7)) @db.Uuid
  directionId     String       @db.Uuid
  name            String
  lessonsCount    Int
  durationMinutes Int          @db.SmallInt
  format          LessonFormat @default(INDIVIDUAL)
  priceUah        Int
  isActive        Boolean      @default(true)
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)

  direction     Direction      @relation(fields: [directionId], references: [id], onDelete: Cascade)
  lessons       Lesson[]
  subscriptions Subscription[]

  @@index([directionId])
}

enum LessonKind {
  TRIAL
  SINGLE
  SUBSCRIPTION
}

enum LessonStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// One table for every kind of lesson. A trial, a single lesson and one drawn
/// from a subscription differ by `kind`, not by which table they live in:
/// separate tables would turn every calendar view into a UNION and would make
/// the overlap check unreliable, because a teacher can only be in one place at
/// a time regardless of who is paying.
///
/// Two rules are enforced by the database rather than by this application,
/// in `20260813195455_add_lessons_and_price_plans`:
///
///   * no two PENDING or CONFIRMED lessons of one teacher may overlap, via a
///     gist exclusion constraint. An application-level "is it free?" check
///     always has a race window - two parents press the button in the same
///     second, both read "free", both write - and the constraint closes it.
///   * `endsAt` must be after `startsAt`.
///
/// `endsAt` is stored next to `durationMinutes` even though it follows from
/// it, because the exclusion constraint indexes `tstzrange(startsAt, endsAt)`
/// and an expression computed per query would not use that index. The two
/// stay consistent because only the booking service writes lessons.
model Lesson {
  id              String       @id @default(uuid(7)) @db.Uuid
  teacherId       String       @db.Uuid
  /// Exactly one of `studentId` and `groupId` is set - `lesson_owner_xor` in
  /// `20260820...add_groups_and_attendance` is what enforces it, because a
  /// lesson with neither owner would be invisible in both cabinets and one
  /// with both would be counted twice.
  studentId       String?      @db.Uuid
  groupId         String?      @db.Uuid
  locationId      String       @db.Uuid
  pricePlanId     String?      @db.Uuid
  /// Set when this lesson is drawn from a package. The draw itself happens
  /// when the lesson is marked completed or missed, not when it is booked.
  subscriptionId  String?      @db.Uuid
  startsAt        DateTime     @db.Timestamptz(3)
  endsAt          DateTime     @db.Timestamptz(3)
  durationMinutes Int          @db.SmallInt
  kind            LessonKind
  status          LessonStatus @default(PENDING)
  cancelledById   String?      @db.Uuid
  cancelReason    String?
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  teacher      TeacherProfile     @relation(fields: [teacherId], references: [userId], onDelete: Restrict)
  student      User?              @relation("StudentLessons", fields: [studentId], references: [id], onDelete: Cascade)
  group        Group?             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  location     Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  pricePlan    PricePlan?         @relation(fields: [pricePlanId], references: [id], onDelete: SetNull)
  subscription Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  cancelledBy  User?              @relation("CancelledLessons", fields: [cancelledById], references: [id], onDelete: SetNull)
  attendance   LessonAttendance[]

  @@index([teacherId, startsAt])
  @@index([studentId, startsAt])
  @@index([groupId, startsAt])
  @@index([subscriptionId])
  @@index([status])
}

/// `ACTIVE` and `CANCELLED` are the only two states a person decides on. There
/// is deliberately no `EXHAUSTED` or `EXPIRED`: both follow from the row
/// itself - `lessonsUsed` against `lessonsTotal`, `validTo` against today - and
/// a stored copy of a derived fact needs a nightly job to stay true.
enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

/// A package of lessons bought from one teacher.
///
/// The count and the price come from the `PricePlan` it was sold against, so a
/// plan of eight lessons cannot be recorded as a package of six. `lessonsUsed`
/// only ever grows, and only when a lesson is marked completed or missed.
model Subscription {
  id           String             @id @default(uuid(7)) @db.Uuid
  studentId    String             @db.Uuid
  teacherId    String             @db.Uuid
  pricePlanId  String             @db.Uuid
  lessonsTotal Int                @db.SmallInt
  lessonsUsed  Int                @default(0) @db.SmallInt
  priceUah     Int
  validFrom    DateTime           @db.Date
  validTo      DateTime           @db.Date
  /// Payment is recorded by the studio, not by an integration - stage 4 has no
  /// online payments, and a package can be used before the cash arrives.
  paidAt       DateTime?          @db.Timestamptz(3)
  status       SubscriptionStatus @default(ACTIVE)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)

  student   User           @relation("StudentSubscriptions", fields: [studentId], references: [id], onDelete: Cascade)
  teacher   TeacherProfile @relation(fields: [teacherId], references: [userId], onDelete: Restrict)
  pricePlan PricePlan      @relation(fields: [pricePlanId], references: [id], onDelete: Restrict)
  lessons   Lesson[]

  @@index([studentId, status])
  @@index([teacherId])
}

/// A standing course: "Вокальний ансамбль, вівторок і четвер о 17:00".
///
/// The lessons themselves are real `Lesson` rows generated from `schedule`,
/// not something derived at read time - only real rows can block the teacher's
/// individual slots and give attendance somewhere to hang.
model Group {
  id                  String    @id @default(uuid(7)) @db.Uuid
  name                String
  teacherId           String    @db.Uuid
  directionId         String    @db.Uuid
  locationId          String    @db.Uuid
  capacity            Int       @db.SmallInt
  durationMinutes     Int       @db.SmallInt
  isOpenForEnrollment Boolean   @default(true)
  startsOn            DateTime  @db.Date
  /// Open-ended courses generate a rolling window of lessons instead.
  endsOn              DateTime? @db.Date
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  teacher     TeacherProfile    @relation(fields: [teacherId], references: [userId], onDelete: Restrict)
  direction   Direction         @relation(fields: [directionId], references: [id], onDelete: Restrict)
  location    Location          @relation(fields: [locationId], references: [id], onDelete: Restrict)
  schedule    GroupSchedule[]
  enrollments GroupEnrollment[]
  lessons     Lesson[]

  @@index([teacherId])
  @@index([directionId])
}

/// When the group meets, as a weekday and a local time of day - the same shape
/// as an availability rule, and for the same reason: "Tuesdays at 17:00" has
/// to stay 17:00 in Kyiv on both sides of a daylight-saving change.
model GroupSchedule {
  id          String @id @default(uuid(7)) @db.Uuid
  groupId     String @db.Uuid
  /// 0 = Sunday, matching `Date.prototype.getUTCDay` and `weekdayOf`.
  weekday     Int    @db.SmallInt
  startMinute Int    @db.SmallInt

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, weekday, startMinute])
}

enum GroupEnrollmentStatus {
  PENDING
  ACTIVE
  LEFT
}

/// One row per person per group, for good. Someone who leaves and comes back
/// reuses their row rather than getting a second one, so the group's history
/// stays readable and the unique index keeps a double application impossible.
model GroupEnrollment {
  id        String                @id @default(uuid(7)) @db.Uuid
  groupId   String                @db.Uuid
  studentId String                @db.Uuid
  status    GroupEnrollmentStatus @default(PENDING)
  joinedAt  DateTime              @default(now()) @db.Timestamptz(3)
  leftAt    DateTime?             @db.Timestamptz(3)

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([groupId, studentId])
  @@index([studentId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

/// The register for one group lesson. Keyed by the pair, so marking a child
/// twice overwrites the mark instead of adding a second one.
model LessonAttendance {
  lessonId  String           @db.Uuid
  studentId String           @db.Uuid
  status    AttendanceStatus
  markedAt  DateTime         @default(now()) @db.Timestamptz(3)

  lesson  Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([lessonId, studentId])
  @@index([studentId])
}

// ---------------------------------------------------------------------------
// Public content. Read-only from the outside until the admin arrives in stage
// 6; every row carries `isPublished`, and the public endpoints never return an
// unpublished one.
// ---------------------------------------------------------------------------

enum StudioEventKind {
  CONCERT
  OPEN_LESSON
  COMPETITION
  OTHER
}

/// A concert, an open lesson, a competition the studio takes part in.
///
/// These are the same rows the cabinet calendar will show, which is why events
/// live in the database while the rest of the site's copy does not: an event
/// has a time, a place, and people expected to be there.
model StudioEvent {
  id          String          @id @default(uuid(7)) @db.Uuid
  slug        String          @unique
  title       String
  description String?
  startsAt    DateTime        @db.Timestamptz(3)
  endsAt      DateTime?       @db.Timestamptz(3)
  locationId  String?         @db.Uuid
  coverUrl    String?
  kind        StudioEventKind @default(CONCERT)
  isPublished Boolean         @default(false)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  location Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  gallery  GalleryItem[]

  @@index([startsAt])
}

enum GalleryItemKind {
  PHOTO
  VIDEO
}

/// A photo or a YouTube embed. `url` is a link rather than an upload: the
/// storage adapter belongs to stage 6, and until it exists the studio's media
/// already lives somewhere with a URL.
model GalleryItem {
  id          String          @id @default(uuid(7)) @db.Uuid
  kind        GalleryItemKind @default(PHOTO)
  url         String
  thumbUrl    String?
  caption     String?
  eventId     String?         @db.Uuid
  sortOrder   Int             @default(0)
  isPublished Boolean         @default(true)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  event StudioEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([eventId])
}

/// What a parent or a student said about the studio. Unpublished by default:
/// nobody's words go on the site until someone decides they should.
model Testimonial {
  id          String   @id @default(uuid(7)) @db.Uuid
  authorName  String
  text        String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
}

/// A competition win or a trip. `year` rather than a date, because that is the
/// precision such things are remembered and listed in.
model Achievement {
  id          String   @id @default(uuid(7)) @db.Uuid
  title       String
  description String?
  year        Int      @db.SmallInt
  imageUrl    String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([year])
}

// ---------------------------------------------------------------------------
// Site copy the studio edits for itself. Everything above is a thing with a
// time, a place or a person attached; these two are words on a page, and they
// live in the database for one reason - so that changing the studio's rules
// does not require a developer and a deploy.
// ---------------------------------------------------------------------------

/// The prose of a page: "Про нас", "Правила студії".
///
/// Keyed by a slug the code knows, not by an id, because these are not
/// arbitrary pages: the set of keys is fixed in `packages/shared`, the admin
/// edits the ones that exist and cannot invent new ones. A page whose row is
/// missing falls back to the copy in the code, so an empty table renders a
/// complete site rather than a blank one.
model SiteText {
  key       String   @id
  title     String
  /// Markdown, rendered by a pure function into React elements - never into
  /// an HTML string, so there is no `dangerouslySetInnerHTML` anywhere on the
  /// path from this column to the page.
  body      String
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

/// Facts about the studio that fit on one line: the phone, the Instagram, the
/// working hours.
///
/// A key-value table rather than a single-row settings model: the fields it
/// holds are exactly the ones the studio has not sent yet, so the set will
/// grow, and growing it should not cost a migration each time. `studio.ts` on
/// the web side stays the default; these rows are laid over it.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
